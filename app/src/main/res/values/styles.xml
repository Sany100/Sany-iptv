<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#20D6A1</item>
        <!-- White defaults prevent dark flashes/gaps in Day mode before Activity styling. -->
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:navigationBarDividerColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <!-- Suppress Android 12+ system app-icon splash during Activity/PiP transitions.
             The app's own startup animation remains responsible for the normal launch logo. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenBackground">#000000</item>
    </style>
</resources>
